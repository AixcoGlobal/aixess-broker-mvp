# Local development only. Enables initial owner setup only from loopback requests.
# Leave blank to test the locked admin state. Never use this to configure production.
LOCAL_ADMIN_EMAIL=

# Production runtime settings are configured in Sites, not bundled into the browser:
# AUTH_PROVIDER=sites
# ADMIN_EMAILS=comma-separated,explicitly-approved,email-addresses
# RATE_LIMIT_SALT=random-secret
# ADMIN_OWNER_EMAIL=initial-owner-email
# ADMIN_SETUP_TOKEN_HASH=sha256-of-private-one-time-setup-key
# ADMIN_SETUP_EXPIRES_AT=unix-milliseconds
